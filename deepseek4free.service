[Unit]
Description=DeepSeek4Free Multi-Account Token Pool & OpenAI API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/deepseek4free
EnvironmentFile=-/root/deepseek4free/.env
ExecStart=/root/deepseek4free/.venv/bin/python /root/deepseek4free/web_server.py
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
